# ====== PRODUCTION ENVIRONMENT ======

# App
APP_NAME=PersonalDNS
APP_ENV=production
DEBUG=false

# Security
SECRET_KEY=your-very-long-random-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_KEY_PREFIX=pdns_

# Database
DATABASE_URL=postgresql://pdnsuser:strong-password@postgres:5432/personaldns
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://:redis-password@redis:6379/0
REDIS_CACHE_TTL=300
REDIS_SESSION_TTL=86400

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://:redis-password@redis:6379/1

# DNS Configuration
DNS_MODE=production
POWERDNS_API_URL=http://powerdns:8081
POWERDNS_API_KEY=your-powerdns-api-key-change-me
POWERDNS_NS1=ns1.yourdomain.com
POWERDNS_NS2=ns2.yourdomain.com

# Frontend
FRONTEND_URL=https://app.yourdomain.com
FRONTEND_DOMAIN=app.yourdomain.com

# CORS
CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com
ALLOWED_HOSTS=api.yourdomain.com,app.yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=10

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=PersonalDNS

# Iran Registrar Integration
IRAN_REGISTRAR_ENABLED=true
IRAN_REGISTRAR_API_KEY=
IRANSERVER_API_USERNAME=
IRANSERVER_API_PASSWORD=
PARS_HOSTING_API_KEY=

# Monitoring & Logging
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
GRAFANA_URL=http://grafana:3000

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Optional: Sentry for error tracking
SENTRY_DSN=

# Optional: Slack notifications
SLACK_WEBHOOK_URL=

# Optional: Two-Factor Authentication
2FA_ENABLED=false
2FA_ISSUER=PersonalDNS
